+static const char *const songs[MUSIC_CONTEXTS][2]={
+ {"bgm_title","bgm_menu2"},{"bgm_stage1","bgm_stage2"},{"bgm_stage2","bgm_stage1"},{"bgm_boss1","bgm_boss2"},
