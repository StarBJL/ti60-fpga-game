+static int locator_cover(uint64_t *left,const uint32_t *rows,int size,int x,int y){
+    int n=0;
+    if(x<=-size||y<=-size||x>=LOC_W||y>=LOC_H)return 0;
+    int start=y<0?-y:0,end=y+size>LOC_H?LOC_H-y:size;
